{
	"name": "codi-go",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"adults": "npm run dev --workspace=@codi-go/adults",
		"students": "npm run dev --workspace=@codi-go/students",
		"build:adults": "npm run build --workspace=@codi-go/adults",
		"build:students": "npm run build --workspace=@codi-go/students",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "npm run typecheck --workspaces --if-present"
	},
	"devDependencies": {
    "@iconify-json/lucide": "^1.2.133",
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "~7.0.2",
		"unocss": "^66.10.2",
		"vite": "^8.3.0"
	}
}
